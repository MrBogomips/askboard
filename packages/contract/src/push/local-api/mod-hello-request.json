{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:local-api:mod-hello-request",
  "title": "Mod hello",
  "description": "The mod's report, once per epoch, of the client it runs in and that client's version, as the mod API gives them (AD-18).",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "urn:askboard:local-api:version"
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    }
  },
  "required": ["version", "client"],
  "additionalProperties": false
}
