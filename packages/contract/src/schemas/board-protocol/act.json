{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:board-protocol:act",
  "title": "Act command",
  "description": "Board page to board-host: one command of the user's explicit acts, applied once per action ID and atomically, in order (AD-10, AD-20): answer (choice, other, optionNotes, note and, since 1.5, the widget values and derived values and, since widget-registry, the widget results, each optional, since ask-core checks that one is there), decline (with its reason as note), postpone, reopen (undoing a sent postpone or decline), note (the open prompt's text alone), follow-up, and edit-choice (reload, or ignore keeping keptRev). Each act names its question, and every act but reopen the revision the user acted on; answers, declines, notes and follow-ups carry when, the time of the user's action as the board stamped it (FR-19). actionId is 22 base64url characters the board page draws for the command, and the command keeps it when it is resent. board-host answers with done or refused naming it, then the state.",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "urn:askboard:board-protocol:version"
    },
    "type": {
      "const": "act"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/act"
      }
    }
  },
  "required": ["version", "type", "actionId", "acts"],
  "additionalProperties": false,
  "$defs": {
    "act": {
      "description": "An act, picked by its type.",
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/answer"
        },
        {
          "$ref": "#/$defs/decline"
        },
        {
          "$ref": "#/$defs/postpone"
        },
        {
          "$ref": "#/$defs/reopen"
        },
        {
          "$ref": "#/$defs/note"
        },
        {
          "$ref": "#/$defs/follow-up"
        },
        {
          "$ref": "#/$defs/edit-choice"
        }
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "type": {
          "const": "answer"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "choice": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "optionNotes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "values": {
          "description": "Since 1.5: the full edited props of each widget item the user changed, by item ID (AD-20); ask-core checks each against its item and the diff against the revision the answer names.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "urn:askboard:input:id"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "results": {
          "description": "Since widget-registry: what the widget items the user gave a result for produced that is no edit, by item ID, each any JSON value its item's type defines (AD-20); ask-core checks each key against the question's widget items and each result against its type's declaration. At least one entry, beside the other content.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "urn:askboard:input:id"
          },
          "additionalProperties": true
        },
        "derived": {
          "description": "Since 1.5: the derived values of the question's computing items as they stood, by reference (AD-13, FR-12), each any JSON value; ask-core checks each key against the widgets' answer declarations.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/reference"
          },
          "additionalProperties": true
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        }
      },
      "required": ["type", "itemId", "rev", "when"],
      "additionalProperties": false
    },
    "reference": {
      "description": "AD-13's reference syntax without brackets: the item ID, then child IDs or a field, separated by dots; never an array index.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(\\.[A-Za-z0-9_-]{1,64})*$"
    },
    "decline": {
      "type": "object",
      "properties": {
        "type": {
          "const": "decline"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        }
      },
      "required": ["type", "itemId", "rev", "when"],
      "additionalProperties": false
    },
    "postpone": {
      "type": "object",
      "properties": {
        "type": {
          "const": "postpone"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["type", "itemId", "rev"],
      "additionalProperties": false
    },
    "reopen": {
      "type": "object",
      "properties": {
        "type": {
          "const": "reopen"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        }
      },
      "required": ["type", "itemId"],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "properties": {
        "type": {
          "const": "note"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        }
      },
      "required": ["type", "itemId", "rev", "note", "when"],
      "additionalProperties": false
    },
    "follow-up": {
      "type": "object",
      "properties": {
        "type": {
          "const": "follow-up"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        }
      },
      "required": ["type", "itemId", "rev", "text", "when"],
      "additionalProperties": false
    },
    "edit-choice": {
      "type": "object",
      "properties": {
        "type": {
          "const": "edit-choice"
        },
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "edit": {
          "enum": ["reload", "ignore"]
        },
        "keptRev": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["type", "itemId", "rev", "edit"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "edit": {
            "const": "ignore"
          }
        }
      },
      "then": {
        "properties": {
          "keptRev": true
        },
        "required": ["keptRev"]
      },
      "else": {
        "properties": {
          "keptRev": false
        }
      }
    }
  }
}
