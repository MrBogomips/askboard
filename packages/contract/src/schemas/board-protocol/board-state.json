{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:board-protocol:board-state",
  "title": "Board state",
  "description": "The ask's state and, per question in board order, its revision, its state, its current answer with the answer's receipt and whether the agent recorded it, the previous answer after a reopen, and its thread of follow-ups with the agent's replies (AD-3, AD-10). A discarded ask's board is told with discarded instead.",
  "type": "object",
  "properties": {
    "ask": {
      "enum": ["waiting", "partly-answered", "answered", "closed"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/openQuestion"
          },
          {
            "$ref": "#/$defs/answeredQuestion"
          }
        ]
      }
    }
  },
  "required": ["ask", "questions"],
  "additionalProperties": false,
  "$defs": {
    "openQuestion": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["open", "postponed"]
        },
        "previous": {
          "$ref": "#/$defs/answer"
        },
        "thread": {
          "$ref": "#/$defs/thread"
        }
      },
      "required": ["itemId", "rev", "state"],
      "additionalProperties": false
    },
    "answeredQuestion": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["answered", "declined"]
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "previous": {
          "$ref": "#/$defs/answer"
        },
        "thread": {
          "$ref": "#/$defs/thread"
        }
      },
      "required": ["itemId", "rev", "state", "answer"],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "optionNotes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "values": {
          "description": "Since 1.5: the logged full props of each widget item the answer changed, by expanded item ID (AD-20); never a derived value, which the view recomputes.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "urn:askboard:input:id"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "declined": {
          "const": true
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        },
        "receipt": {
          "enum": ["sent", "delivered"]
        },
        "recorded": {
          "const": true
        }
      },
      "required": ["when", "receipt"],
      "additionalProperties": false
    },
    "thread": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/followUp"
      }
    },
    "followUp": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "urn:askboard:output:cursor"
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reply"
          }
        }
      },
      "required": ["cursor", "who", "when", "text", "replies"],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "when": {
          "$ref": "urn:askboard:board-protocol:time"
        }
      },
      "required": ["text", "when"],
      "additionalProperties": false
    }
  }
}
