{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:board-protocol:answer",
  "title": "Answer command",
  "description": "Board page to board-host: the user's explicit answer to a question at its current revision, stamped when the user acted (AD-10, FR-19).",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "urn:askboard:board-protocol:version"
    },
    "type": {
      "const": "answer"
    },
    "itemId": {
      "$ref": "urn:askboard:input:id"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "choice": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "when": {
      "$ref": "urn:askboard:board-protocol:time"
    }
  },
  "required": ["version", "type", "itemId", "rev", "choice", "when"],
  "additionalProperties": false
}
