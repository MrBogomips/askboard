{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:tool-envelopes:ask-result",
  "title": "Ask result",
  "description": "What ask returns at once, before any user action (FR-21): the versions, the epoch, the ask's ID and state, its first cursor and its board link (AD-6). An identical resend returns the same link and cursor with the ask's current state (FR-5). E1's sessions run without hooks, so every result carries the no-hooks warning (AD-5).",
  "type": "object",
  "properties": {
    "versions": {
      "$ref": "urn:askboard:tool-envelopes:versions"
    },
    "epoch": {
      "$ref": "urn:askboard:output:epoch"
    },
    "askId": {
      "$ref": "urn:askboard:input:id"
    },
    "state": {
      "$ref": "urn:askboard:output:ask-state"
    },
    "cursor": {
      "$ref": "urn:askboard:output:cursor"
    },
    "board": {
      "description": "http://127.0.0.1:<port>/b/<askId>?t=<token> (AD-11, Consistency Conventions).",
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/b/[A-Za-z0-9_-]{1,64}\\?t=[A-Za-z0-9_-]{22,256}$"
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:askboard:output:warning"
      }
    }
  },
  "required": ["versions", "epoch", "askId", "state", "cursor", "board"],
  "additionalProperties": false
}
