{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:tool-envelopes:fetch-result",
  "title": "Fetch result",
  "description": "What fetch returns for an item of an open or closed ask whose full value fits one result (FR-20, AD-6): the versions, the epoch, the ask's ID and state, and the item as ask-core holds it now. Nothing of the draft record. A longer value comes in pages (fetch-page). An ask without an owner check is unchecked (AD-5).",
  "type": "object",
  "properties": {
    "versions": {
      "$ref": "urn:askboard:tool-envelopes:versions"
    },
    "epoch": {
      "$ref": "urn:askboard:output:epoch"
    },
    "askId": {
      "$ref": "urn:askboard:input:id"
    },
    "state": {
      "$ref": "urn:askboard:output:ask-state"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "unchecked": {
      "const": true
    }
  },
  "required": ["versions", "epoch", "askId", "state", "item"],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "description": "An item as ask-core holds it now: a question with its type, rev, props and state, its current answer when it is answered or declined, and its previous answer after a reopen; or an area with its title and questions, which has no rev or state of its own.",
      "type": "object",
      "properties": {
        "type": {
          "enum": ["question", "area"]
        },
        "id": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "type": "object"
        },
        "state": {
          "$ref": "urn:askboard:output:question-state"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "previous": {
          "$ref": "#/$defs/answer"
        }
      },
      "required": ["type", "id", "props"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "type": {
            "const": "area"
          }
        }
      },
      "then": {
        "properties": {
          "rev": false,
          "state": false,
          "answer": false,
          "previous": false,
          "props": {
            "$ref": "urn:askboard:board-document:board-document#/$defs/areaProps"
          }
        }
      },
      "else": {
        "required": ["rev", "state"],
        "properties": {
          "props": {
            "$ref": "urn:askboard:input:question-props"
          },
          "rev": true,
          "state": true
        },
        "if": {
          "properties": {
            "state": {
              "enum": ["answered", "declined"]
            }
          }
        },
        "then": {
          "properties": {
            "answer": true
          },
          "required": ["answer"]
        },
        "else": {
          "properties": {
            "answer": false
          }
        }
      }
    },
    "answer": {
      "description": "An answer in full as ask-core holds it (FR-20): its content, who and when, and either the cursor of its answer event or recorded, for an answer the agent recorded, which has no event (proposal, open question 3).",
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "urn:askboard:output:cursor"
        },
        "choice": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "optionNotes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "declined": {
          "const": true
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "when": {
          "$ref": "urn:askboard:output:time"
        },
        "recorded": {
          "const": true
        }
      },
      "required": ["who", "when"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "recorded": {
            "const": true
          }
        },
        "required": ["recorded"]
      },
      "then": {
        "properties": {
          "cursor": false
        }
      },
      "else": {
        "properties": {
          "cursor": true
        },
        "required": ["cursor"]
      }
    }
  }
}
