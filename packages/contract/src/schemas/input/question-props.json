{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:input:question-props",
  "title": "Question props",
  "description": "A question: its text, optional header chip, options, multiSelect, and allowOther, which offers the \"Other…\" row (FR-3). An option is its label, unique within the question, an optional description, preview and annotation, each plain text, and recommended, which at most one option of a question sets (proposal, open question 9); the contract's validation function checks the uniqueness rules. Since input format 1.2 a question's `items` hold its context, each picked by its `type`: excerpts, references and images (excerpts, design decision 2); widget items stay refused until the widget follow-up appends their types.",
  "type": "object",
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "header": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    },
    "multiSelect": { "type": "boolean" },
    "allowOther": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "required": ["text", "options"],
  "additionalProperties": false,
  "$defs": {
    "option": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "preview": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "annotation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "recommended": { "const": true }
      },
      "required": ["label"],
      "additionalProperties": false
    },
    "item": {
      "description": "An item of a question, picked by its type.",
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        { "$ref": "#/$defs/excerpt" },
        { "$ref": "#/$defs/reference" },
        { "$ref": "#/$defs/image" }
      ]
    },
    "excerpt": {
      "type": "object",
      "properties": {
        "type": { "const": "excerpt" },
        "id": { "$ref": "urn:askboard:input:id" },
        "props": { "$ref": "urn:askboard:input:excerpt-props" }
      },
      "required": ["type", "id", "props"],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "type": { "const": "reference" },
        "id": { "$ref": "urn:askboard:input:id" },
        "props": { "$ref": "urn:askboard:input:reference-props" }
      },
      "required": ["type", "id", "props"],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "type": { "const": "image" },
        "id": { "$ref": "urn:askboard:input:id" },
        "props": { "$ref": "urn:askboard:input:image-props" }
      },
      "required": ["type", "id", "props"],
      "additionalProperties": false
    }
  }
}
