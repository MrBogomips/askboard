{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:askboard:snapshot-data:snapshot-data",
  "title": "Snapshot data",
  "description": "A Snapshot's askboard-data block (AD-15; snapshot design decision 2): the versions it follows, the Snapshot's record, the epoch and ask ID, the current board document, the earlier revisions its events name, the board state as the board receives it, the ask's origin as the board protocol's origin message carries it when known, and every logged event with the full values kept for its answer; optionally the molecule expansion map and kept diagram renders. document and state keep BootData's names, so the view boots a Snapshot as it boots a board (AD-9). Every level refuses the fields it does not define, so nothing of a draft record, no token, no board link and no agent status can be held.",
  "type": "object",
  "properties": {
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "snapshot": {
      "$ref": "#/$defs/record"
    },
    "epoch": {
      "$ref": "urn:askboard:output:epoch"
    },
    "askId": {
      "$ref": "urn:askboard:input:id"
    },
    "document": {
      "$ref": "urn:askboard:board-document:board-document"
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "state": {
      "$ref": "urn:askboard:board-protocol:board-state"
    },
    "origin": {
      "$ref": "urn:askboard:board-protocol:origin"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/logged"
      }
    },
    "molecules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expansion"
      }
    },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/render"
      }
    }
  },
  "required": [
    "versions",
    "snapshot",
    "epoch",
    "askId",
    "document",
    "revisions",
    "state",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "minor": {
      "description": "A version of major 1, as major.minor.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "versions": {
      "description": "The versions the data follows: this set's, the output format's (the events) and the board protocol's (the board state).",
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/minor"
        },
        "output": {
          "$ref": "#/$defs/minor"
        },
        "boardProtocol": {
          "$ref": "urn:askboard:board-protocol:version"
        }
      },
      "required": ["snapshot", "output", "boardProtocol"],
      "additionalProperties": false
    },
    "record": {
      "description": "When the Snapshot was taken and by whom: the agent, or the user, named as answers name them (FR-19). unsentWork records that the board held unsent work, as the board's request said.",
      "type": "object",
      "properties": {
        "takenAt": {
          "$ref": "urn:askboard:output:time"
        },
        "takenBy": {
          "enum": ["agent", "user"]
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unsentWork": {
          "const": true
        }
      },
      "required": ["takenAt", "takenBy"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "takenBy": {
            "const": "user"
          }
        }
      },
      "then": {
        "properties": {
          "who": true
        },
        "required": ["who"]
      },
      "else": {
        "properties": {
          "who": false,
          "unsentWork": false
        }
      }
    },
    "revision": {
      "description": "An earlier revision of a question that an event names, with the props it had then.",
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "$ref": "urn:askboard:input:question-props"
        }
      },
      "required": ["itemId", "rev", "props"],
      "additionalProperties": false
    },
    "logged": {
      "description": "One event of the log, in seq order with its cursor, and the full values ask-core keeps for its answer, by item ID in reference addressing (open question A2).",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/event"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "urn:askboard:output:answer-event#/$defs/reference"
          }
        }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "event": {
      "description": "An event of the output format, picked by its type: every one an ask that is not discarded can log, so no discarded event.",
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "urn:askboard:output:answer-event"
        },
        {
          "$ref": "urn:askboard:output:postponed-event"
        },
        {
          "$ref": "urn:askboard:output:reopened-event"
        },
        {
          "$ref": "urn:askboard:output:note-event"
        },
        {
          "$ref": "urn:askboard:output:follow-up-event"
        },
        {
          "$ref": "urn:askboard:output:edit-choice-event"
        },
        {
          "$ref": "urn:askboard:output:closed-event"
        }
      ]
    },
    "expansion": {
      "description": "One entry of the molecule expansion map: an expanded item ID, the reference it expands, and the molecule and version it came from, so a reader can join the expanded documents with the referenced events.",
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "reference": {
          "$ref": "urn:askboard:output:answer-event#/$defs/reference"
        },
        "molecule": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["itemId", "reference", "molecule", "version"],
      "additionalProperties": false
    },
    "render": {
      "description": "A kept diagram render of one item's revision, as SVG text for each theme (open question B3).",
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "urn:askboard:input:id"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "light": {
          "type": "string",
          "minLength": 1
        },
        "dark": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["itemId", "rev", "light", "dark"],
      "additionalProperties": false
    }
  }
}
