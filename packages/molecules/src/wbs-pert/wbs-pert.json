{
  "format": "1.0.0",
  "molecule": "wbs-pert",
  "version": "1.0.0",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:askboard:molecule:wbs-pert:1",
    "title": "WBS with PERT parameters",
    "description": "The data an agent sends for a work breakdown with PERT (FR-15): its work packages, nested, each with three-point estimates in working days, and how many levels open at first. AskBoard derives each package's expected effort and spread, and their roll-ups.",
    "type": "object",
    "properties": {
      "nodes": {
        "description": "The top-level work packages, in order.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/node"
        }
      },
      "depth": {
        "description": "How many levels open when the board first shows the work breakdown: 2 when left out.",
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      }
    },
    "required": ["nodes"],
    "additionalProperties": false,
    "$defs": {
      "node": {
        "description": "A work package: its ID, unique in the work breakdown, its name, its sub-packages and its estimates.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:askboard:input:id"
          },
          "label": {
            "$ref": "urn:askboard:input:tree-props#/$defs/node/properties/label"
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "optimistic": {
            "$ref": "#/$defs/estimate"
          },
          "mostLikely": {
            "$ref": "#/$defs/estimate"
          },
          "pessimistic": {
            "$ref": "#/$defs/estimate"
          },
          "excerpt": {
            "description": "Where in the project the package comes from, as path#Heading or path#L10-L40.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": ["id", "label"],
        "additionalProperties": false
      },
      "estimate": {
        "description": "Working days, from 0 to 100,000.",
        "type": "number",
        "minimum": 0,
        "maximum": 100000
      }
    }
  },
  "items": [
    {
      "type": "tree",
      "id": "tree",
      "props": {
        "columns": [
          {
            "field": "optimistic",
            "label": "Optimistic",
            "type": "number"
          },
          {
            "field": "mostLikely",
            "label": "Most likely",
            "type": "number"
          },
          {
            "field": "pessimistic",
            "label": "Pessimistic",
            "type": "number"
          }
        ],
        "nodes": [],
        "pert": true,
        "openDepth": 2
      }
    }
  ],
  "fills": {
    "nodes": [
      {
        "pointer": "/0/props/nodes",
        "as": {
          "omit": ["excerpt"]
        }
      }
    ],
    "depth": [
      {
        "pointer": "/0/props/openDepth"
      }
    ]
  }
}
