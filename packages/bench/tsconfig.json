{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // bench runs out of process on Bun today and uses Node's API and the globals Bun and Node share.
    // bench declares @types/bun itself (early-benchmark, open question 9); test/runtime.test.ts keeps
    // Bun-only APIs out of src (AD-19).
    "types": ["bun"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
