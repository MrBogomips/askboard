    },
    {
      "id": "if-empty-result",
      "op": "IF",
      "formula": "IF(TRUE,[x.e],1)",
      "expected": 0,
      "use": ["misc"]
    },
    {
      "id": "round-half",
      "op": "ROUND",
      "formula": "ROUND(2.5,0)",
      "expected": 3
    },
    {
      "id": "round-half-negative",
      "op": "ROUND",
