{
  "description": "Whitelist fixtures with Excel's values, adapted from the formula spike's probe (openspec/changes/spike-formula/probe/fixtures/whitelist.json): every case verbatim. The input sets become the fields and children of one item x; the list set's members are renamed (l.a to la) so that child IDs are unique within x, and formulas read them only through wildcards. A case loads item x from the sets it uses plus its own inputs, then item t with the field r: its formula, of `type` (default number). `expected` is Excel's documented value; `excel` and `js` note where Excel and JavaScript differ. Cases of the seven dropped functions keep their Excel values as a record, and the test expects them refused.",
  "inputSets": {
    "misc": {
      "fields": {
        "e": {
          "type": "number",
          "value": null
        },
        "b": {
          "type": "boolean",
          "value": true
        },
        "t": {
          "type": "text",
          "value": "5"
        },
        "s": {
          "type": "text",
          "value": "abc"
        },
        "zero": {
          "type": "number",
          "value": 0
        }
      }
    },
    "dates": {
      "fields": {
        "mon": {
          "type": "date",
          "value": "2026-11-02"
        },
        "fri": {
          "type": "date",
          "value": "2026-11-06"
        },
        "sat": {
          "type": "date",
          "value": "2026-11-07"
        },
        "dec31": {
          "type": "date",
          "value": "2026-12-31"
        },
        "leap": {
          "type": "date",
          "value": "2028-02-28"
        }
      }
    },
    "list": {
      "children": [
        {
          "id": "l",
          "children": [
            {
              "id": "la",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 1
                },
                "w": {
                  "type": "number",
                  "value": 4
                },
                "u": {
                  "type": "text",
                  "value": "n/a"
                }
              }
            },
            {
              "id": "lb",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 2
                },
                "w": {
                  "type": "number",
                  "value": 5
                },
                "u": {
                  "type": "number",
                  "value": 2
                }
              }
            },
            {
              "id": "lc",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 3
                },
                "w": {
                  "type": "number",
                  "value": 6
                },
                "u": {
                  "type": "number",
                  "value": 3
                }
              }
            }
          ]
        },
        {
          "id": "m",
          "children": [
            {
              "id": "ma",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 1
                }
              }
            },
            {
              "id": "mb",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 2
                }
              }
            }
          ]
        },
        {
          "id": "k",
          "children": [
            {
              "id": "ka",
              "fields": {
                "v": {
                  "type": "number",
                  "value": 1
                }
              }
            },
            {
              "id": "kb",
              "fields": {
                "v": {
                  "type": "number",
                  "formula": "1/0"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "id": "add",
      "op": "+",
      "formula": "1+2",
      "expected": 3
    },
    {
      "id": "add-float",
      "op": "+",
      "formula": "0.1+0.2",
      "expected": 0.3,
      "excel": "0.3 shown; 0.30000000000000004 stored",
      "js": 0.30000000000000004,
      "note": "binary floating point in both engines: passes at 1e-9, counted as an exact mismatch"
    },
    {
      "id": "add-bool",
      "op": "+",
      "formula": "TRUE+TRUE",
      "expected": 2
    },
    {
      "id": "add-text-number",
      "op": "+",
      "formula": "\"3\"+1",
      "expected": 4,
      "note": "numeric text converts; plain decimal only, whatever the locale"
    },
    {
      "id": "add-text",
      "op": "+",
      "formula": "\"abc\"+1",
      "expected": {
        "error": "value"
      },
      "excel": "#VALUE!",
      "js": "abc1"
    },
    {
      "id": "add-text-comma",
      "op": "+",
      "formula": "\"1,5\"+1",
      "expected": {
        "error": "value"
      },
      "note": "locale-independent: Excel in de-DE would read 1,5 as 1.5"
    },
    {
      "id": "add-empty",
      "op": "+",
      "formula": "[x.e]+1",
      "expected": 1,
      "use": ["misc"],
      "js": "null+1 = 1, undefined+1 = NaN"
    },
    {
      "id": "sub",
      "op": "-",
      "formula": "5-7",
      "expected": -2
    },
    {
      "id": "sub-left-assoc",
      "op": "-",
      "formula": "10-2-3",
      "expected": 5
    },
    {
      "id": "neg-bool",
      "op": "-",
      "formula": "-TRUE",
      "expected": -1
    },
    {
      "id": "neg-double",
      "op": "-",
      "formula": "--3",
      "expected": 3
    },
    {
      "id": "mul",
      "op": "*",
      "formula": "6*7",
      "expected": 42
    },
    {
      "id": "mul-empty",
      "op": "*",
      "formula": "[x.e]*5",
      "expected": 0,
      "use": ["misc"]
    },
    {
      "id": "mul-bool",
      "op": "*",
      "formula": "TRUE*5",
      "expected": 5
    },
    {
      "id": "div",
      "op": "/",
      "formula": "7/2",
      "expected": 3.5
    },
    {
      "id": "div-left-assoc",
      "op": "/",
      "formula": "12/3/2",
      "expected": 2
    },
    {
      "id": "div-zero",
      "op": "/",
      "formula": "1/0",
      "expected": {
        "error": "division-by-zero"
      },
      "excel": "#DIV/0!",
      "js": "Infinity"
    },
    {
      "id": "div-zero-zero",
      "op": "/",
      "formula": "0/0",
      "expected": {
        "error": "division-by-zero"
      },
      "excel": "#DIV/0!",
      "js": "NaN"
    },
    {
      "id": "div-empty",
      "op": "/",
      "formula": "1/[x.e]",
      "expected": {
        "error": "division-by-zero"
      },
      "use": ["misc"]
    },
    {
      "id": "overflow",
      "op": "*",
      "formula": "1E308*10",
      "expected": {
        "error": "value"
      },
      "excel": "#NUM!",
      "js": "Infinity"
    },
    {
      "id": "pow",
      "op": "^",
      "formula": "2^10",
      "expected": 1024
    },
    {
      "id": "pow-left-assoc",
      "op": "^",
      "formula": "2^3^2",
      "expected": 64,
      "excel": "64: ^ is left-associative",
      "js": "2**3**2 = 512"
    },
    {
      "id": "pow-unary-minus",
      "op": "^",
      "formula": "-2^2",
      "expected": 4,
      "excel": "4: negation binds tighter than ^",
      "js": "-(2**2) = -4"
    },
    {
      "id": "pow-binary-minus",
      "op": "^",
      "formula": "0-2^2",
      "expected": -4
    },
    {
      "id": "pow-neg-exponent",
      "op": "^",
      "formula": "2^-1",
      "expected": 0.5
    },
    {
      "id": "pow-zero-zero",
      "op": "^",
      "formula": "0^0",
      "expected": {
        "error": "value"
      },
      "excel": "#NUM!",
      "js": "1"
    },
    {
      "id": "precedence-mul",
      "op": "*",
      "formula": "1+2*3",
      "expected": 7
    },
    {
      "id": "precedence-paren",
      "op": "*",
      "formula": "(1+2)*3",
      "expected": 9
    },
    {
      "id": "precedence-pow",
      "op": "^",
      "formula": "2*3^2",
      "expected": 18
    },
    {
      "id": "eq",
      "op": "=",
      "formula": "1=1",
      "expected": true
    },
    {
      "id": "eq-float",
      "op": "=",
      "formula": "0.1+0.2=0.3",
      "expected": true,
      "excel": "TRUE: compared at 15 significant digits",
      "js": "false"
    },
    {
      "id": "eq-text-case",
      "op": "=",
      "formula": "\"a\"=\"A\"",
      "expected": true,
      "excel": "TRUE: text compares case-insensitively",
      "js": "false"
    },
    {
      "id": "eq-number-text",
      "op": "=",
      "formula": "1=\"1\"",
      "expected": false
    },
    {
      "id": "eq-empty-zero",
      "op": "=",
      "formula": "[x.e]=0",
      "expected": true,
      "use": ["misc"]
    },
    {
      "id": "eq-empty-text",
      "op": "=",
      "formula": "[x.e]=\"\"",
      "expected": true,
      "use": ["misc"]
    },
    {
      "id": "eq-empty-false",
      "op": "=",
      "formula": "[x.e]=FALSE",
      "expected": true,
      "use": ["misc"]
    },
    {
      "id": "ne",
      "op": "<>",
      "formula": "1<>2",
      "expected": true
    },
    {
      "id": "ne-empty",
      "op": "<>",
      "formula": "[x.e]<>\"\"",
      "expected": false,
      "use": ["misc"]
    },
    {
      "id": "lt",
      "op": "<",
      "formula": "1<2",
      "expected": true
    },
    {
      "id": "lt-number-text",
      "op": "<",
      "formula": "1<\"a\"",
      "expected": true,
      "excel": "numbers < text < booleans"
    },
    {
      "id": "lt-text-bool",
      "op": "<",
      "formula": "\"z\"<TRUE",
      "expected": true
    },
    {
      "id": "lt-chain",
      "op": "<",
      "formula": "1<2<3",
      "expected": false,
      "excel": "(1<2)<3 is TRUE<3, FALSE: booleans sort after numbers"
    },
    {
      "id": "le",
      "op": "<=",
      "formula": "2<=2",
      "expected": true
    },
    {
      "id": "gt",
      "op": ">",
      "formula": "\"b\">\"a\"",
      "expected": true
    },
    {
      "id": "ge",
      "op": ">=",
      "formula": "FALSE>=TRUE",
      "expected": false
    },
    {
      "id": "text-literal",
      "op": "=",
      "formula": "\"\"\"\"=\"\"\"\"",
      "expected": true,
      "note": "doubled quotes escape a quote"
    },
    {
      "id": "sum",
      "op": "SUM",
      "formula": "SUM(1,2,3)",
      "expected": 6
    },
    {
      "id": "sum-wildcard",
      "op": "SUM",
      "formula": "SUM([x.l.*.v])",
      "expected": 6,
      "use": ["list"]
    },
    {
      "id": "sum-ref-bool",
      "op": "SUM",
      "formula": "SUM([x.b])",
      "expected": 0,
      "use": ["misc"],
      "excel": "0: a boolean inside a reference is ignored"
    },
    {
      "id": "sum-direct-bool",
      "op": "SUM",
      "formula": "SUM(TRUE,1)",
      "expected": 2,
      "excel": "2: a boolean typed directly counts"
    },
    {
      "id": "sum-ref-text",
      "op": "SUM",
      "formula": "SUM([x.t])",
      "expected": 0,
      "use": ["misc"],
      "excel": "0: text inside a reference is ignored"
    },
    {
      "id": "sum-direct-text",
      "op": "SUM",
      "formula": "SUM(\"5\",1)",
      "expected": 6
    },
    {
      "id": "sum-bad-text",
      "op": "SUM",
      "formula": "SUM(\"abc\")",
      "expected": {
        "error": "value"
      }
    },
    {
      "id": "sum-empty",
      "op": "SUM",
      "formula": "SUM([x.e])",
      "expected": 0,
      "use": ["misc"]
    },
    {
      "id": "sum-error",
      "op": "SUM",
      "formula": "SUM([x.k.*.v])",
      "expected": {
        "error": "division-by-zero"
      },
      "use": ["list"]
    },
    {
      "id": "min",
      "op": "MIN",
      "formula": "MIN(3,1,2)",
      "expected": 1
    },
    {
      "id": "min-empty",
      "op": "MIN",
