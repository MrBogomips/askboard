{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_askboard_askboard__.*|mcp__askboard__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/askboard\" hook PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/askboard\" hook PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_askboard_askboard__ask|mcp__askboard__ask",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/askboard\" hook PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/askboard\" hook SubagentStop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": ["./askboard-mod.js"]
}
