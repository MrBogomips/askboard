#!/bin/sh
# The plugin's start script (plugin-release, design decision 1; AD-19, Node form). The server entry
# and every hook run it as `sh scripts/askboard [hook <event> | client <path> [<body>]]`. When
# `node` on PATH is 24.22.1 or later it replaces itself with Node on the bundle, so Claude Code
# stays the parent of the session process (AD-5). It makes no network request.

set -u

REQUIRED=24.22.1

# The plugin root: the folder above the one this script lives in, through every symlink.
self=$0
while [ -h "$self" ]; do
  dir=$(cd -P "$(dirname -- "$self")" && pwd -P) || exit 1
  target=$(readlink -- "$self") || exit 1
  case $target in
    /*) self=$target ;;
    *) self=$dir/$target ;;
  esac
done
ROOT=$(cd -P "$(dirname -- "$self")/.." && pwd -P) || exit 1

# at_least <found> <required>: both are major.minor.patch of digits; true when found >= required.
at_least() {
  case $1 in
    *[!0-9.]* | '' | .* | *. | *..*) return 1 ;;
  esac
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $1 $2
  IFS=$old_ifs
  [ $# -eq 6 ] || return 1
  [ "$1" -gt "$4" ] && return 0
  [ "$1" -lt "$4" ] && return 1
  [ "$2" -gt "$5" ] && return 0
  [ "$2" -lt "$5" ] && return 1
  [ "$3" -ge "$6" ]
}

found=$(node -p process.versions.node 2>/dev/null) || found=
if at_least "$found" "$REQUIRED"; then
  exec node "$ROOT/dist/askboard.mjs" "$@"
fi

# Refusals by mode arrive with the next task: for now, say why and fail.
printf 'askboard: needs Node %s or later on PATH; found %s\n' "$REQUIRED" "${found:-none}" >&2
exit 1
