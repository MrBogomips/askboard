#!/bin/sh
# The plugin's start script (plugin-release, design decision 1; AD-19, Node form). The server entry
# and every hook run it as `sh scripts/askboard [hook <event> | client <path> [<body>]]`. When
# `node` on PATH is 24.22.1 or later it replaces itself with Node on the bundle, so Claude Code
# stays the parent of the session process (AD-5). It makes no network request.
#
# When Node is missing or older, each mode refuses in its own way (decision 2, AD-19, NFR-8): the
# session process answers the MCP handshake with no tools and the reason in its instructions, until
# stdin closes; a hook exits 0 with one stderr line; the client and anything else exit 1 with one.

set -u

REQUIRED=24.22.1

# The plugin root: the folder above the one this script lives in, through every symlink.
self=$0
while [ -h "$self" ]; do
  dir=$(cd -P "$(dirname -- "$self")" && pwd -P) || exit 1
  target=$(readlink -- "$self") || exit 1
  case $target in
    /*) self=$target ;;
    *) self=$dir/$target ;;
  esac
done
ROOT=$(cd -P "$(dirname -- "$self")/.." && pwd -P) || exit 1

# at_least <found> <required>: both are major.minor.patch of digits; true when found >= required.
at_least() {
  case $1 in
    *[!0-9.]* | '' | .* | *. | *..*) return 1 ;;
  esac
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $1 $2
  IFS=$old_ifs
  [ $# -eq 6 ] || return 1
  [ "$1" -gt "$4" ] && return 0
  [ "$1" -lt "$4" ] && return 1
  [ "$2" -gt "$5" ] && return 0
  [ "$2" -lt "$5" ] && return 1
  [ "$3" -ge "$6" ]
}

# Run outside the project (review 1.5, X-1): files in the user's project (a Volta hooks.json naming a
# script, a version file a shim reads, a bunfig.toml preload) must not choose or run code when the
# runtime starts. The session process reads the project from CLAUDE_PROJECT_DIR, which keeps its
# value or takes the caller's directory, and the hooks read theirs from their input's cwd.
CLAUDE_PROJECT_DIR=${CLAUDE_PROJECT_DIR:-$PWD}
export CLAUDE_PROJECT_DIR
cd "$ROOT" || exit 1

found=$(node -p process.versions.node 2>/dev/null) || found=
if at_least "$found" "$REQUIRED"; then
  exec node "$ROOT/dist/askboard.mjs" "$@"
fi

# --- Refusals -------------------------------------------------------------------------------------

# What was found, as one short printable line: a version string is data from another program.
shown=$(printf '%s' "$found" | LC_ALL=C tr -c ' -~' '?' | cut -c1-64)
if [ -z "$shown" ]; then
  reason="Node $REQUIRED or later was not found on PATH"
else
  reason="Node $REQUIRED or later is needed on PATH; found $shown"
fi
printf 'askboard: %s\n' "$reason" >&2

case ${1-} in
  '') ;;
  hook) exit 0 ;;
  *) exit 1 ;;
esac

# The product version for serverInfo, from the plugin manifest beside the root.
version=$(sed -n 's/^  "version": "\([0-9][0-9.]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)
[ -n "$version" ] || version=unknown

# The answers to one line of input: awk reads a JSON object's top-level "id" and "method" and prints
# the reply, or nothing for a notification, a line that is no JSON object or an ID that is no string
# or number. The reason and version come in through the environment and are escaped there.
# shellcheck disable=SC2016
PROGRAM='
function esc(s,   out, i, c) {
  out = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\\" || c == "\"") out = out "\\" c
    else if (index(PRINTABLE, c) > 0) out = out c
    else out = out "?"
  }
  return out
}
function ws() { while (pos <= n && index(" \t\r", substr(L, pos, 1)) > 0) pos++ }
function str(   c) {
  if (substr(L, pos, 1) != "\"") return 0
  pos++
  while (pos <= n) {
    c = substr(L, pos, 1)
    if (c == "\\") { pos += 2; continue }
    if (c == "\"") { pos++; return 1 }
    pos++
  }
  return 0
}
function skipvalue(   c, depth, start) {
  c = substr(L, pos, 1)
  if (c == "\"") return str()
  if (c == "{" || c == "[") {
    depth = 0
    while (pos <= n) {
      c = substr(L, pos, 1)
      if (c == "\"") { if (!str()) return 0; continue }
      if (c == "{" || c == "[") depth++
      else if (c == "}" || c == "]") { depth--; if (depth == 0) { pos++; return 1 } }
      pos++
    }
    return 0
  }
  start = pos
  while (pos <= n && index(",} \t\r", substr(L, pos, 1)) == 0) pos++
  return pos > start
}
function protocol(   at, value) {
  at = index(L, "\"protocolVersion\"")
  if (at == 0) return "\"2025-06-18\""
  pos = at + 17
  ws()
  if (substr(L, pos, 1) != ":") return "\"2025-06-18\""
  pos++
  ws()
  value = pos
  if (!str()) return "\"2025-06-18\""
  return substr(L, value, pos - value)
}
{
  L = $0; n = length(L); pos = 1; id = ""; hasid = 0; method = ""; ok = 1
  ws()
  if (substr(L, pos, 1) != "{") next
  pos++
  ws()
  if (substr(L, pos, 1) == "}") pos++
  else while (1) {
    ws(); ks = pos
    if (!str()) { ok = 0; break }
    key = substr(L, ks + 1, pos - ks - 2)
    ws()
    if (substr(L, pos, 1) != ":") { ok = 0; break }
    pos++
    ws(); vs = pos
    if (!skipvalue()) { ok = 0; break }
    value = substr(L, vs, pos - vs)
    if (key == "id" && !hasid) { id = value; hasid = 1 }
    if (key == "method" && method == "") method = value
    ws()
    c = substr(L, pos, 1)
    if (c == ",") { pos++; continue }
    if (c == "}") { pos++; break }
    ok = 0; break
  }
  if (!ok) next
  ws()
  if (pos <= n || !hasid || id !~ /^("|-?[0-9])/) next
  head = "{\"jsonrpc\":\"2.0\",\"id\":" id ","
  if (method == "\"initialize\"")
    print head "\"result\":{\"protocolVersion\":" protocol() ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"askboard\",\"version\":\"" esc(ENVIRON["ASKBOARD_VERSION"]) "\"},\"instructions\":\"" esc(ENVIRON["ASKBOARD_INSTRUCTIONS"]) "\"}}"
  else if (method == "\"tools/list\"") print head "\"result\":{\"tools\":[]}}"
  else if (method == "\"ping\"") print head "\"result\":{}}"
  else print head "\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}"
}
'

PRINTABLE=' !#$%&'"'"'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~'
INSTRUCTIONS="AskBoard cannot start: $reason. Install it, then restart the session or reconnect AskBoard in /mcp. Until then, ask the user another way."
export ASKBOARD_VERSION="$version" ASKBOARD_INSTRUCTIONS="$INSTRUCTIONS"

# The session process: answer each line until stdin closes, then exit 0, never earlier, so that
# Claude Code keeps the server instead of caching a failed start.
while IFS= read -r line || [ -n "$line" ]; do
  reply=$(printf '%s\n' "$line" | LC_ALL=C awk -v "PRINTABLE=$PRINTABLE" "$PROGRAM" 2>/dev/null)
  [ -z "$reply" ] || printf '%s\n' "$reply"
done
exit 0
