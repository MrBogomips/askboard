{
  "modules": ["./register.js"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*probe.*__probe_.*",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hook.ts\" PreToolUse", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*probe.*__probe_ask",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hook.ts\" PostToolUse", "timeout": 5 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hook.ts\" SubagentStop", "timeout": 5 }]
      }
    ]
  }
}
