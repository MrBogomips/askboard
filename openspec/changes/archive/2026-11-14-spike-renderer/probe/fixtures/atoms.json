      "value": "Flaky upstream"
    },
    {
      "action": "fill",
      "selector": "#nf1-input",
      "value": "3"
    },
    {
      "action": "click",
      "selector": "#c1-expo"
    },
    {
      "action": "click",
      "selector": "#c2-get"
    },
    {
      "action": "click",
      "selector": "#tg1-switch"
    },
    {
      "action": "click",
      "selector": "[data-item-id=tb1] [role=tab]:nth-child(2)"
    },
    {
      "action": "click",
      "selector": "#tg2-switch"
