{
  "description": "Every atom and layout of task 2.1, once, under a Stack.",
  "board": {
    "id": "atoms",
    "title": "Atoms and layouts",
    "items": [
      {
        "id": "s1",
        "type": "Stack",
        "children": [
          {
            "id": "t1",
            "type": "Text",
            "props": {
              "text": "Which retry policy should the client use?"
            }
          },
          {
            "id": "v1",
            "type": "Value",
            "props": {
              "label": "Expected effort",
              "value": 12.5
            }
          },
          {
            "id": "tf1",
            "type": "TextField",
            "props": {
              "label": "Reason"
            }
          },
          {
