                }
              ]
            }
          },
          {
            "id": "c2",
            "type": "Choice",
            "props": {
              "label": "Apply to",
              "multiple": true,
              "options": [
                {
                  "value": "get",
                  "label": "GET"
                },
                {
                  "value": "post",
                  "label": "POST"
                }
              ]
            }
          },
          {
            "id": "tg1",
            "type": "Toggle",
            "props": {
              "label": "Retry on timeout"
            }
          },
          {
            "id": "r1",
            "type": "Row",
            "props": {
              "widths": [
                2,
                1
              ]
            },
            "children": [
              {
                "id": "t2",
                "type": "Text",
                "props": {
                  "text": "Wide column"
                }
              },
              {
                "id": "t3",
                "type": "Text",
                "props": {
                  "text": "Narrow column"
                }
              }
            ]
          },
          {
            "id": "g1",
            "type": "Group",
            "props": {
              "title": "Limits"
            },
            "children": [
              {
                "id": "tf2",
                "type": "TextField",
                "props": {
                  "label": "Maximum delay"
                }
              }
            ]
          },
          {
            "id": "tb1",
            "type": "Tabs",
            "props": {
              "label": "Views",
              "tabs": [
                "Summary",
                "Details"
              ]
            },
            "children": [
              {
                "id": "t4",
                "type": "Text",
                "props": {
                  "text": "Summary tab"
                }
              },
              {
                "id": "tg2",
                "type": "Toggle",
                "props": {
                  "label": "Show details"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "check": {
    "selector": "[data-item-id=t1]",
    "text": "retry policy"
  },
  "edits": [
    {
      "action": "fill",
