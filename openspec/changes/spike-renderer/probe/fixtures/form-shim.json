{
  "description": "S-4, S-7, S-8: the Form, with the style-element shim for its Select",
  "board": {
    "id": "form-shim",
    "title": "S-4, S-7, S-8: the Form, with the style-element shim for its Select",
    "items": [
      {
        "id": "f1",
        "type": "Form",
        "props": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "title": "Name",
                "pattern": "^[A-Z][a-z]+$"
              },
              "colour": {
                "type": "string",
                "title": "Colour",
                "enum": [
                  "r",
                  "g",
                  "b"
                ]
              },
              "size": {
                "type": "string",
                "title": "Size",
                "enum": [
                  "s",
                  "m",
                  "l"
                ]
              },
              "tags": {
                "type": "array",
                "title": "Tags",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "a",
                    "b",
                    "c"
                  ]
                }
              }
            }
          },
          "uiSchema": {
            "colour": {
              "ui:widget": "radio",
              "ui:enumNames": [
                "Red",
                "Green",
                "Blue"
              ]
            },
            "size": {
              "ui:widget": "select",
              "ui:enumNames": [
                "Small",
                "Medium",
                "Large"
              ]
            },
            "tags": {
              "ui:widget": "checkboxes",
              "items": {
                "ui:enumNames": [
                  "Alpha",
                  "Beta",
                  "Gamma"
                ]
              }
            }
          },
          "extraErrors": {
            "name": {
              "__errors": [
                "Use a capitalised name (AskBoard's field check)"
              ]
            }
          },
          "styleShim": true
        }
      }
    ]
  },
  "actions": [
    {
      "do": "fill",
      "selector": "#root_name",
      "value": "Ada"
    },
    {
      "do": "press",
      "selector": "#root_name",
      "key": "Enter"
    },
    {
      "do": "click",
      "selector": "label[for=root_colour-g]"
    },
    {
      "do": "click",
      "selector": "#root_size"
    },
    {
      "do": "click",
      "selector": "[role=option]:has-text('Medium')"
    },
    {
      "do": "click",
      "selector": "label[for=root_tags-a]"
    },
    {
      "do": "click",
      "selector": "label[for=root_tags-c]"
    }
  ],
  "expectDraft": {
    "f1": {
      "name": "Ada",
      "colour": "g",
      "size": "m",
      "tags": [
        "a",
        "c"
      ]
    },
    "ui:f1": null
  },
  "check": {
    "selector": "[data-item-id=f1]",
    "text": "Use a capitalised name"
  }
}
