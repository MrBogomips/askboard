{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!.claude",
      "!docs",
      "!drafts",
      "!openspec",
      "!bun.lock",
      "!packages/contract/test/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  }
}
